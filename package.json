{
  "name": "patchdesk",
  "version": "0.0.20",
  "private": true,
  "productName": "Patchdesk",
  "license": "MIT",
  "description": "Local-first desktop workbench for safe pull request review.",
  "type": "module",
  "main": "./out/main/electron-main.js",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "lint:staged": "node scripts/lint-staged.mjs",
    "lint:changed": "node scripts/check-changed-source.mjs",
    "gate:preflight": "node scripts/gate-preflight.mjs",
    "dev:copy-profile": "node scripts/dev-copy-profile.mjs",
    "cdp:ready": "node scripts/cdp-ready.mjs",
    "knip": "knip",
    "knip:ratchet": "node scripts/check-knip-ratchet.mjs",
    "check:error-ui": "node scripts/check-renderer-error-surfaces.mjs",
    "check:imports": "node scripts/check-parent-imports.mjs",
    "check": "node scripts/run-full-check.mjs",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "node scripts/check-scripts-types.mjs",
    "test": "vitest",
    "test:root": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:all": "pnpm test:root",
    "test:e2e": "pnpm build && playwright test",
    "dev": "node scripts/dev.mjs",
    "mcp:shim": "node scripts/mcp-shim.mjs",
    "build": "electron-vite build",
    "build:icon": "node scripts/build-app-icon.mjs",
    "verify:icon": "node scripts/verify-app-icon.mjs",
    "package:mac": "pnpm build && pnpm verify:icon && node scripts/package-mac.mjs",
    "install:mac": "pnpm package:mac && node scripts/install-mac.mjs",
    "electron-builder:mac": "electron-builder --mac --publish never",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:cask": "node scripts/bump-cask.mjs",
    "test:performance": "pnpm build && playwright test tests/browser/performance.spec.ts",
    "test:package-smoke": "node scripts/package-smoke.mjs",
    "check:bundle": "node scripts/generate-pierre-theme-catalog.mjs --check && node scripts/check-renderer-bundles.mjs",
    "docs:mcp-tools": "node scripts/generate-mcp-tools-doc.mjs",
    "test:bundle": "pnpm build && pnpm check:bundle",
    "doctor": "react-doctor --scope full",
    "precommit": "node scripts/precommit.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.12",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@oxlint/plugins": "1.78.0",
    "@pierre/diffs": "^1.2.12",
    "@pierre/theme": "1.1.0",
    "@pierre/theming": "0.0.2",
    "@pierre/trees": "1.0.0-beta.5",
    "@shikijs/themes": "4.3.1",
    "@swc/core": "^1.15.3",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@valibot/to-json-schema": "1.8.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^6.32.3",
    "lucide-react": "^1.25.0",
    "marked": "18.0.7",
    "mermaid": "11.16.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "^1.54.2",
    "react": "^19.1.1",
    "react-doctor": "^0.9.11",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@8.8.0+sha1.9922e8b650d393700209ccd81e0ebdbcbe43b0d3",
  "pnpm": {
    "overrides": {
      "oxfmt@0.63.0>tinypool": "2.1.2"
    }
  },
  "build": {
    "appId": "io.github.kwanpham2195.patchdesk",
    "productName": "Patchdesk",
    "asar": true,
    "asarUnpack": [],
    "npmRebuild": false,
    "afterPack": "scripts/sign-mac-adhoc.mjs",
    "extraResources": [
      {
        "from": "out/main/pi-explanation-helper.mjs",
        "to": "pi-explanation/index.mjs"
      },
      {
        "from": "out/main/mcp-shim.js",
        "to": "mcp-shim/index.js"
      },
      {
        "from": "resources/bin/patchdesk",
        "to": "bin/patchdesk"
      },
      {
        "from": "scripts/install-release.sh",
        "to": "install-release.sh"
      }
    ],
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "!out/main/mcp-shim.js",
      "!out/main/pi-explanation-helper.mjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/patchdesk.icns",
      "target": [
        "dir",
        "zip",
        "dmg"
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronLanguages": [
      "en"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*",
    "#scripts/*": "./scripts/*",
    "#tools/*": "./tools/*",
    "#package": "./package.json",
    "#resources/*": "./resources/*"
  }
}
