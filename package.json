{
  "name": "patchdesk",
  "version": "0.1.0",
  "private": true,
  "productName": "Patchdesk",
  "license": "MIT",
  "description": "Local-first desktop workbench for safe pull request review.",
  "type": "module",
  "main": "./out/main/electron-main.js",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "lint:staged": "node scripts/lint-staged.mjs",
    "lint:changed": "node scripts/check-changed-source.mjs",
    "knip": "knip",
    "knip:ratchet": "node scripts/check-knip-ratchet.mjs",
    "check:error-ui": "node scripts/check-renderer-error-surfaces.mjs",
    "check": "pnpm typecheck && pnpm typecheck:scripts && pnpm check:error-ui && pnpm test:all && pnpm lint:staged && pnpm lint:changed -- origin/main && pnpm knip:ratchet",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "node scripts/check-scripts-types.mjs",
    "test": "vitest",
    "test:root": "vitest --run",
    "test:flue": "pnpm --dir runtime/flue test -- --run",
    "test:all": "pnpm test:root && pnpm test:flue",
    "test:ui": "vitest --run dashboard.ui",
    "test:e2e": "pnpm build && playwright test",
    "dev": "pnpm --dir runtime/flue build && electron-vite dev",
    "build": "electron-vite build",
    "stage:flue-runtime": "node scripts/stage-flue-runtime.mjs",
    "build:icon": "node scripts/build-app-icon.mjs",
    "verify:icon": "node scripts/verify-app-icon.mjs",
    "package:mac": "pnpm build && pnpm stage:flue-runtime && pnpm verify:icon && electron-builder --mac",
    "test:performance": "pnpm build && playwright test tests/browser/performance.spec.ts",
    "test:package-smoke": "node scripts/package-smoke.mjs",
    "test:bundle": "node scripts/generate-pierre-theme-catalog.mjs --check && pnpm build && node scripts/check-renderer-bundles.mjs",
    "doctor": "react-doctor --scope full",
    "precommit": "pnpm lint:staged && react-doctor --staged --blocking warning --yes",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky && pnpm --dir runtime/flue install --frozen-lockfile && pnpm --dir runtime/flue build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "^2.1.1",
    "@pierre/diffs": "^1.2.12",
    "@pierre/theme": "1.1.0",
    "@pierre/theming": "0.0.2",
    "@pierre/trees": "1.0.0-beta.5",
    "@shikijs/themes": "4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.2",
    "lucide-react": "^1.25.0",
    "marked": "18.0.7",
    "mermaid": "11.16.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@swc/core": "^1.15.3",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^6.32.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "^1.54.2",
    "react-doctor": "^0.9.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@8.8.0+sha1.9922e8b650d393700209ccd81e0ebdbcbe43b0d3",
  "build": {
    "appId": "com.centraldigital.patchdesk",
    "productName": "Patchdesk",
    "asar": true,
    "asarUnpack": [],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "out/workflow-runtime",
        "to": "flue-runtime",
        "filter": [
          "!node_modules/**"
        ]
      },
      {
        "from": "out/workflow-runtime/node_modules",
        "to": "flue-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/patchdesk.icns",
      "target": [
        "dir",
        "zip"
      ],
      "identity": null
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
