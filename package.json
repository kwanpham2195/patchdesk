{
  "name": "patchdesk",
  "version": "0.1.0",
  "private": true,
  "productName": "Patchdesk",
  "description": "Local-first desktop workbench for safe pull request review.",
  "type": "module",
  "main": "./out/main/electron-main.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --run dashboard.ui",
    "test:e2e": "pnpm build && playwright test",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "stage:flue-runtime": "node scripts/stage-flue-runtime.mjs",
    "build:icon": "node scripts/build-app-icon.mjs",
    "verify:icon": "node scripts/verify-app-icon.mjs",
    "package:mac": "pnpm build && pnpm stage:flue-runtime && pnpm verify:icon && electron-builder --mac dir",
    "test:a11y": "pnpm build && playwright test tests/browser/accessibility.spec.ts",
    "test:performance": "pnpm build && playwright test tests/browser/performance.spec.ts",
    "test:package-smoke": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-ai": "0.80.7",
    "@flue/cli": "1.0.0-beta.9",
    "@flue/react": "1.0.0-beta.9",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/sdk": "1.0.0-beta.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "^2.0.3",
    "@pierre/diffs": "^1.2.12",
    "@pierre/theme": "1.1.0",
    "@pierre/theming": "0.0.2",
    "@pierre/trees": "1.0.0-beta.5",
    "@shikijs/themes": "4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.8.3",
    "lucide-react": "^1.25.0",
    "marked": "18.0.7",
    "mermaid": "11.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@swc/core": "^1.15.3",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@8.8.0+sha1.9922e8b650d393700209ccd81e0ebdbcbe43b0d3",
  "build": {
    "appId": "com.centraldigital.patchdesk",
    "productName": "Patchdesk",
    "asar": true,
    "asarUnpack": [
      "src/workflows/**",
      "src/skills/**",
      "node_modules/@flue/**"
    ],
    "extraResources": [
      {
        "from": "out/workflow-runtime",
        "to": "flue-runtime",
        "filter": [
          "!node_modules/**"
        ]
      },
      {
        "from": "out/workflow-runtime/node_modules",
        "to": "flue-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "out/**",
      "src/workflows/**",
      "src/skills/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/patchdesk.icns",
      "target": [
        "dir"
      ],
      "identity": null
    }
  }
}
