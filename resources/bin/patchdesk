#!/bin/sh
# `patchdesk mcp`: runs the MCP shim on the Node that ships inside Patchdesk.app
# (ADR 0052 "Packaging"). Installed at Contents/Resources/bin/patchdesk and
# usually reached through a symlink (the cask's `binary`, or `ln -s`), so the
# link is followed to find the bundle.
set -eu

self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
resources="$(cd "$(dirname "$self")/.." && pwd -P)"

ELECTRON_RUN_AS_NODE=1 exec "$resources/../MacOS/Patchdesk" "$resources/mcp-shim/index.js" "$@"
