{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "out/**",
      "release/**",
      "test-results/**",
      "runtime/insight/**",
      "tools/oxlint/anti-slop/**",
      ".agents/skills/install-anti-slop/**"
    ],
    "overrides": [
      {
        "files": ["scripts/**/*.mjs"],
        "rules": ["eslint/no-undef"]
      }
    ]
  }
}
