{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/**/*.{ts,tsx}", "src/mcp/main.ts", "src/services/walkthrough-generation-service.ts"],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,tsx}"
      ],
      "ignore": ["src/renderer/src/components/ui/**"],
      "ignoreBinaries": ["ditto", "mkfifo"]
    },
    "runtime/insight": {
      "entry": ["scripts/*.mjs", "tests/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"]
    }
  }
}
