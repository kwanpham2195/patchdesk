{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/replay/*.mjs",
        "tests/**/*.{ts,tsx}",
        "src/mcp/main.ts",
        "src/adapters/pi-cli/pi-explanation-helper.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,tsx}"
      ],
      "ignore": ["src/renderer/src/components/ui/**"],
      "ignoreBinaries": ["ditto", "mkfifo"]
    }
  }
}
